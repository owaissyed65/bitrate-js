{
  "name": "bitrate-js",
  "version": "0.1.0",
  "description": "Client-side HLS / adaptive-bitrate video packager. Chunk, transcode and upload large videos entirely in the browser — Rust/WASM + WebCodecs, no server.",
  "keywords": [
    "hls",
    "abr",
    "adaptive-bitrate",
    "video",
    "transcode",
    "transcoder",
    "remux",
    "webcodecs",
    "wasm",
    "webassembly",
    "rust",
    "streaming",
    "video-streaming",
    "client-side",
    "browser",
    "fmp4",
    "cmaf",
    "m3u8",
    "m4s",
    "mp4",
    "h264",
    "segmenter",
    "chunking",
    "video-upload",
    "ffmpeg-alternative",
    "serverless"
  ],
  "license": "MIT",
  "homepage": "https://github.com/OWNER/bitrate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/bitrate.git",
    "directory": "js"
  },
  "bugs": {
    "url": "https://github.com/OWNER/bitrate/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/presigned": {
      "types": "./dist/adapters/presigned.d.ts",
      "import": "./dist/adapters/presigned.js"
    },
    "./adapters/s3": {
      "types": "./dist/adapters/s3.d.ts",
      "import": "./dist/adapters/s3.js"
    },
    "./adapters/supabase": {
      "types": "./dist/adapters/supabase.d.ts",
      "import": "./dist/adapters/supabase.js"
    },
    "./adapters/appwrite": {
      "types": "./dist/adapters/appwrite.d.ts",
      "import": "./dist/adapters/appwrite.js"
    },
    "./global": "./dist/bitrate.global.js",
    "./zip": {
      "types": "./dist/zip.d.ts",
      "import": "./dist/zip.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build ../crates/bitrate-core --target web --out-dir ../../js/src/wasm --out-name bitrate_core && node scripts/inline-wasm.mjs",
    "build": "npm run build:wasm && tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync:readme": "node scripts/sync-readme.mjs",
    "prepublishOnly": "npm run sync:readme && npm run build && npm run typecheck && npm run test"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3",
    "@supabase/supabase-js": ">=2",
    "appwrite": ">=14"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "appwrite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "fake-indexeddb": "^6.2.5",
    "mp4box": "^2.4.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
